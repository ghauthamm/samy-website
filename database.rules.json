{
    "rules": {
        ".read": "auth != null",
        ".write": "auth != null",
        "products": {
            ".read": true,
            ".write": "auth != null",
            ".indexOn": [
                "category",
                "name",
                "price"
            ]
        },
        "orders": {
            ".indexOn": [
                "userId",
                "createdAt",
                "status"
            ],
            "$orderId": {
                ".read": "auth != null",
                ".write": "auth != null"
            }
        },
        "users": {
            "$userId": {
                ".read": "auth != null && auth.uid == $userId",
                ".write": "auth != null && auth.uid == $userId"
            }
        },
        "employees": {
            ".read": "auth != null",
            ".write": "auth != null",
            ".indexOn": ["department", "name", "status"]
        },
        "maintenance": {
            ".read": "auth != null",
            ".write": "auth != null",
            ".indexOn": ["status", "category", "priority"]
        },
        "attendance": {
            ".read": "auth != null",
            ".write": "auth != null"
        }
    }
}